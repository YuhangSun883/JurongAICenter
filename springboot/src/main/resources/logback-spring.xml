<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 2026-08-13:用 Spring Boot 的 ColorConverter 开启彩色日志(改回 IDE 友好格式) -->
    <conversionRule conversionWord="clr"
        class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
        class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
        class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx</pattern>
        </encoder>
    </appender>

    <!-- 2026-08-13:用户要求后端日志写到独立文件,方便排查(不写到 API 文档 md,避免覆盖) -->
    <!--  使用简单 FileAppender + append=true,不滚动,文件可能很大但能跑就行 -->
    <!--  2026-08-15:log.path 系统属性可覆盖,默认写到 ./logs/backend-run.log -->
    <appender name="MD_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${log.path:-./logs}/backend-run.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%15.15t] %-40.40logger{39} : %m%n%wEx</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="MD_FILE"/>
    </root>

    <logger name="com.jurong.aicenter" level="INFO"/>
</configuration>
