<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  UserRepository 的 XML 映射示例。
  简单 SQL 建议用 @Select 注解（同接口 UserRepository.findByEmail），
  复杂 SQL（多表联查、动态条件）才放到这里。

  namespace 必须与对应的 Mapper 接口全限定名一致。
-->
<mapper namespace="com.jurong.aicenter.repository.UserRepository">

    <!-- 基础结果映射（驼峰自动转换已在 application.yml 全局开启） -->
    <resultMap id="UserResultMap" type="com.jurong.aicenter.entity.User">
        <id     column="id"                  property="id"/>
        <result column="email"               property="email"/>
        <result column="password_hash"       property="passwordHash"/>
        <result column="display_name"        property="displayName"/>
        <result column="role"                property="role"/>
        <result column="credits"             property="credits"/>
        <result column="monthly_quota"       property="monthlyQuota"/>
        <result column="quota_used"          property="quotaUsed"/>
        <result column="quota_period_start"  property="quotaPeriodStart"/>
        <result column="plan"                property="plan"/>
        <result column="plan_expires_at"     property="planExpiresAt"/>
        <result column="created_at"          property="createdAt"/>
        <result column="updated_at"          property="updatedAt"/>
        <result column="deleted"             property="deleted"/>
    </resultMap>

    <!-- 通用列片段，便于复用 -->
    <sql id="Base_Column_List">
        id, email, password_hash, display_name, role,
        credits, monthly_quota, quota_used, quota_period_start,
        plan, plan_expires_at, created_at, updated_at, deleted
    </sql>

    <!-- 示例：用 XML 写的 existsByEmail（注解版是 findByEmail） -->
    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM users WHERE email = #{email} AND deleted = 0
        )
    </select>

</mapper>
